              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \" \",\n  \"descripcion\": \"\",\n  \"categoria\": \"\",\n  \"precio\": -12,\n  \"stock\": -1,\n  \"disponible\": true,\n  \"destacado\": false,\n  \"sku\": \"\",\n  \"imagen\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "var respuesta = pm.response.json();",
                  "console.log(\"HTTP \" + pm.response.code + \" - errores de validación:\", respuesta.errores);",
                  "pm.test(\"El cuerpo incluye status 400 y errores por campo\", function () {",
                  "    pm.expect(respuesta.status).to.eql(400);",
                  "    pm.expect(respuesta.errores).to.be.an(\"object\");",
                  "    [\"nombre\", \"descripcion\", \"categoria\", \"precio\", \"stock\", \"sku\", \"imagen\"].forEach(function (campo) {",
                  "        pm.expect(respuesta.errores).to.have.property(campo);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
