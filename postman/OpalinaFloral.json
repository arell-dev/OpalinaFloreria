                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Crea un pedido de demostración usando clienteId de GET - Listar clientes y productoId del producto creado. La fecha futura se genera al enviar. Esta operación persiste el pedido y descuenta una unidad del stock.",
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"modalidad\": \"RECOJO\",\n  \"direccion\": \"\",\n  \"referencia\": \"\",\n  \"fecha\": \"{{fechaPedido}}\",\n  \"hora\": \"12:00:00\",\n  \"metodoPago\": \"YAPE\",\n  \"items\": [\n    {\n      \"productoId\": {{productoId}},\n      \"cantidad\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var fechaFutura = new Date();",
                  "fechaFutura.setDate(fechaFutura.getDate() + 30);",
                  "pm.collectionVariables.set(\"fechaPedido\", fechaFutura.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var respuesta = pm.response.json();",
                  "pm.test(\"El pedido se creó y se guardó su id\", function () {",
                  "    pm.expect(respuesta.id).to.be.a(\"number\").and.to.be.above(0);",
                  "    pm.expect(respuesta.codigo).to.match(/^OP-\\d{4}-\\d+$/);",
                  "    pm.collectionVariables.set(\"pedidoId\", respuesta.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Buscar pedido por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "Consulta el pedido creado por POST - Crear pedido.",
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos",
                "{{pedidoId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"El id coincide con el pedido creado\", function () {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"pedidoId\")));",
                  "    pm.expect(pm.response.json().codigo).to.match(/^OP-\\d{4}-\\d+$/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH - Cambiar estado del pedido",
