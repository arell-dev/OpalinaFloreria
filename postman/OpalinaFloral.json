            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ramo de demostración Postman\",\n  \"descripcion\": \"Producto de prueba creado mediante la API REST.\",\n  \"categoria\": \"Demostración\",\n  \"precio\": 65.5,\n  \"stock\": 5,\n  \"disponible\": true,\n  \"destacado\": false,\n  \"sku\": \"{{skuDemo}}\",\n  \"imagen\": \"/assets/imagenes/productos/12-RamoOpalinaMorado.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"skuDemo\", \"POSTMAN-DEMO-\" + Date.now());",
                  "pm.collectionVariables.set(\"productoId\", \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var respuesta = pm.response.json();",
                  "pm.test(\"La respuesta contiene el id y SKU creados\", function () {",
                  "    pm.expect(respuesta.id).to.be.a(\"number\").and.to.be.above(0);",
                  "    pm.expect(respuesta.sku).to.eql(pm.collectionVariables.get(\"skuDemo\"));",
                  "    pm.collectionVariables.set(\"productoId\", respuesta.id);",
                  "});"
                ]
              }
            }
          ]
        },
