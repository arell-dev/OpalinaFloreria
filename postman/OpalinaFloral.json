              "raw": "{{baseUrl}}/api/productos/{{productoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productoId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
