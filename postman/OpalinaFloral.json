            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Cambia un pedido de PENDIENTE a EN_PROCESO. Ejecuta después de POST - Crear pedido.",
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos",
                "{{pedidoId}}",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
